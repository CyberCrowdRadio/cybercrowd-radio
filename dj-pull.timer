# CYBERCROWD
# LANE: LIVE STREAM - OCEAN DROPLET
# FILE: dj-pull.timer
# JOB: Call the repo pull every 5 minutes, and soon after boot.

[Unit]
Description=Cybercrowd Radio - Repo Pull Timer

[Timer]
Unit=dj-pull.service
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
